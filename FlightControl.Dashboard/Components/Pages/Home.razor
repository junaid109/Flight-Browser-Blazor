@page "/"
@using FlightControl.ServiceDefaults
@using FlightControl.Dashboard
@inject FlightApiClient ApiClient
@implements IDisposable

<PageTitle>Airport Control Dashboard</PageTitle>

<div class="dashboard-container">
    <!-- Left Sidebar: Flight List -->
    <div class="card">
        <div class="card-header">Active Flights</div>
        <div class="flight-list">
            @if (flights == null)
            {
                <div class="p-3">Connecting to Radar...</div>
            }
            else
            {
                @foreach (var flight in flights.OrderBy(f => f.FlightNumber))
                {
                    <div class="flight-item @(selectedFlight?.Id == flight.Id ? "active" : "")" @onclick="() => selectedFlight = flight">
                        <div class="flight-id">@flight.FlightNumber</div>
                        <div>
                            <div style="font-size: 0.7rem; color: var(--text-secondary)">ALT: @flight.Altitude.ToString("N0") FT</div>
                            <div style="font-size: 0.7rem; color: var(--text-secondary)">SPD: @flight.Speed.ToString("N0") KTS</div>
                        </div>
                        <div class="flight-status">@flight.Status</div>
                    </div>
                }
            }
        </div>
    </div>

    <!-- Center: Radar Map -->
    <div class="map-container">
        <div class="grid-overlay"></div>
        <svg style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 1;" viewBox="0 0 100 100" preserveAspectRatio="none">
            <!-- Simplified World Map Background -->
            <g fill="rgba(255, 255, 255, 0.05)" stroke="none">
                <!-- North America -->
                <path d="M10,20 L30,15 L45,18 L40,30 L20,35 L10,20 Z" />
                <!-- South America -->
                <path d="M35,45 L45,45 L50,60 L40,75 L30,55 Z" />
                <!-- Europe/Asia -->
                <path d="M50,15 L70,12 L90,15 L95,30 L80,40 L60,35 L50,25 Z" />
                <!-- Africa -->
                <path d="M50,40 L65,40 L70,55 L60,70 L50,55 Z" />
                <!-- Australia -->
                <path d="M80,60 L95,60 L90,75 L75,70 Z" />
            </g>
            @if (flights != null)
            {
                @foreach (var flight in flights)
                {
                    if (flight.History != null && flight.History.Count > 1)
                    {
                        var points = string.Join(" ", flight.History.Select(h => 
                        {
                            var (px, py) = Project(h.Latitude, h.Longitude);
                            return $"{px:F1},{py:F1}";
                        }));
                        var (cx, cy) = Project(flight.Latitude, flight.Longitude);
                        points += $" {cx:F1},{cy:F1}";

                        <polyline points="@points" fill="none" stroke="@(selectedFlight?.Id == flight.Id ? "var(--accent)" : "rgba(255,255,255,0.15)")" stroke-width="@(selectedFlight?.Id == flight.Id ? "1.5" : "0.5")" />
                    }
                }
            }
        </svg>

        <div class="hud-overlay" style="z-index: 2;">
            <div class="hud-panel">
                <div style="color: var(--accent); font-weight: 700;">RADAR ACTIVE</div>
                <div style="font-size: 0.7rem; color: var(--text-secondary)">REGION: GLOBAL SECTOR</div>
            </div>
            @if (selectedFlight != null)
            {
                <div class="hud-panel">
                    <div style="color: var(--warning); font-weight: 700;">TRACKING: @selectedFlight.FlightNumber</div>
                    <div style="font-size: 0.8rem;">LAT: @selectedFlight.Latitude.ToString("F4")</div>
                    <div style="font-size: 0.8rem;">LON: @selectedFlight.Longitude.ToString("F4")</div>
                    <div style="font-size: 0.7rem; margin-top: 4px; color: var(--text-secondary)">@selectedFlight.Origin &rarr; @selectedFlight.Destination</div>
                </div>
            }
        </div>

        @if (flights != null)
        {
            @foreach (var flight in flights)
            {
                /* Simple projection: map lat 30-60 and lon -130 to 20 to percentage */
                var (x, y) = Project(flight.Latitude, flight.Longitude);

                <div class="plane-marker" style="left: @(x)%; top: @(y)%; z-index: 3;" @onclick="() => selectedFlight = flight">
                    <svg class="plane-icon" style="transform: rotate(@(flight.Heading)deg)" viewBox="0 0 24 24">
                        <path d="M21,16L22,13L15,10L15,3.5A1.5,1.5 0 0,0 13.5,2A1.5,1.5 0 0,0 12,3.5V10L5,13L6,16L12,14V19L10,21V22L13.5,21L17,22V21L15,19V14L21,16Z" />
                    </svg>
                    <div style="position: absolute; top: 100%; left: 50%; transform: translateX(-50%); white-space: nowrap; font-size: 0.6rem; color: var(--text-secondary)">
                        @flight.FlightNumber
                    </div>
                </div>
            }
        }
    </div>

    <!-- Right Sidebar: Stats & Weather -->
    <div class="card">
        <div class="card-header">System Operations</div>
        
        <div class="mb-4">
            <div class="stat-value">@(flights?.Length ?? 0)</div>
            <div class="stat-label">Total In-Sector Flights</div>
        </div>

        <div class="mb-4">
            <div class="stat-value" style="color: var(--success)">NORMAL</div>
            <div class="stat-label">Traffic Density</div>
        </div>

        <div class="card-header mt-4">Weather Stations</div>
        <div class="hud-panel">
            <div style="display: flex; justify-content: space-between;">
                <span>JFK</span>
                <span style="color: var(--success)">CLEAR</span>
            </div>
            <div style="font-size: 0.7rem; color: var(--text-secondary)">WIND: 12KT @@ 220°</div>
        </div>
        <div class="hud-panel">
            <div style="display: flex; justify-content: space-between;">
                <span>LHR</span>
                <span style="color: var(--warning)">FOGGY</span>
            </div>
            <div style="font-size: 0.7rem; color: var(--text-secondary)">VIS: 500M</div>
        </div>

        @if (selectedFlight != null)
        {
            <div class="card-header mt-4">Telemetry: @selectedFlight.FlightNumber</div>
            <div class="hud-panel">
                <div style="font-size: 0.7rem; color: var(--text-secondary); margin-bottom: 8px;">ALTITUDE PROFILE</div>
                
                <svg width="100%" height="60" viewBox="0 0 100 100" preserveAspectRatio="none" style="border-bottom: 1px solid var(--text-secondary); overflow: visible;">
                    @{
                         var hist = selectedFlight.History;
                         if (hist != null && hist.Count > 1)
                         {
                             var maxAlt = hist.Max(h => h.Altitude) + 500;
                             var minAlt = Math.Max(0, hist.Min(h => h.Altitude) - 500);
                             var range = maxAlt - minAlt;
                             if (range == 0) range = 1;
                             
                             var points = "";
                             for(int i=0; i<hist.Count; i++)
                             {
                                 var h = hist[i];
                                 var x = (double)i / (hist.Count - 1) * 100.0;
                                 var y = 100 - ((h.Altitude - minAlt) / range * 100.0);
                                 points += $"{x:F1},{y:F1} ";
                             }
                             <polyline points="@points" fill="none" stroke="var(--accent)" stroke-width="2" vector-effect="non-scaling-stroke" />
                         }
                    }
                </svg>
                <div style="display: flex; justify-content: space-between; font-size: 0.6rem; color: var(--text-secondary); margin-top: 4px;">
                     <span>PAST</span>
                     <span>NOW</span>
                </div>

                <div style="margin-top: 12px; display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
                     <div>
                        <div style="font-size: 0.6rem; color: var(--text-secondary)">ORIGIN</div>
                        <div style="font-weight: bold">@selectedFlight.Origin</div>
                     </div>
                     <div>
                        <div style="font-size: 0.6rem; color: var(--text-secondary)">DESTINATION</div>
                        <div style="font-weight: bold">@selectedFlight.Destination</div>
                     </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .mb-4 { margin-bottom: 24px; }
    .mt-4 { margin-top: 24px; }
    .flight-item.active {
        background: rgba(59, 130, 246, 0.15);
        border-left: 3px solid var(--accent);
    }
</style>

@code {
    private Flight[]? flights;
    private Flight? selectedFlight;
    private Timer? timer;

    protected override async Task OnInitializedAsync()
    {
        // Initial fetch
        await UpdateData();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            timer = new Timer(async _ =>
            {
                await InvokeAsync(UpdateData);
            }, null, 1000, 1000);
        }
    }

    private async Task UpdateData()
    {
        try
        {
            flights = await ApiClient.GetFlightsAsync();
            if (selectedFlight != null)
            {
                selectedFlight = flights.FirstOrDefault(f => f.Id == selectedFlight.Id);
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Radar connection failure: {ex.Message}");
        }
    }

    public void Dispose()
    {
        timer?.Dispose();
    }

    private (double x, double y) Project(double lat, double lon)
    {
        var x = (lon + 130) * (100.0 / 150.0);
        var y = (60 - lat) * (100.0 / 30.0);
        return (x, y);
    }
}
